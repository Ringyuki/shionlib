  "paths": {
    "/favorites": {
      "get": {
        "operationId": "favorite.list",
        "parameters": [
          {
            "description": "Owner whose lists to show; defaults to the caller",
            "explode": false,
            "in": "query",
            "name": "user_id",
            "schema": {
              "description": "Owner whose lists to show; defaults to the caller",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "When set, every list reports whether it contains this game",
            "explode": false,
            "in": "query",
            "name": "game_id",
            "schema": {
              "description": "When set, every list reports whether it contains this game",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
