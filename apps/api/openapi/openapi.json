              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "accessToken": []
          },
          {
            "accessCookie": []
          }
        ],
        "summary": "Create a favorite list",
        "tags": [
          "favorite"
        ]
