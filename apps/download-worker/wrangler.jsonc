{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shionlib-download-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-18",
  "durable_objects": {
    "bindings": [
      {
        "name": "DOWNLOAD_LIMITER",
        "class_name": "DownloadLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DownloadLimiter"],
    },
  ],
  "routes": [{ "pattern": "dl.hikarifallback.uk", "custom_domain": true }],
  "vars": {
    "DOWNLOAD_MAX_CONNS_CAP": "8",
    "DOWNLOAD_LEASE_TTL_MS": "45000",
    "DOWNLOAD_HEARTBEAT_MS": "15000",
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
}
