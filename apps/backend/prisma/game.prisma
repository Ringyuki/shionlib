// game status: 1 -> visible, 2 -> hide
// game staffs: Array<Record<name, role>>
// extra_info: Array<Record<key, value>>
model Game {
  id           Int         @id @default(autoincrement())
  v_id         String?
  b_id         String?
  h_id         Int?        @unique
  title_jp     String      @default("") @db.VarChar(255)
  title_zh     String      @default("") @db.VarChar(255)
  title_en     String      @default("") @db.VarChar(255)
  aliases      String[]    @default([])
  intro_jp     String      @default("") @db.VarChar(20000)
  intro_zh     String      @default("") @db.VarChar(20000)
  intro_en     String      @default("") @db.VarChar(20000)
  covers       GameCover[] @relation("game_cover")
  images       GameImage[] @relation("game_image")
  release_date DateTime?
  release_date_tba Boolean   @default(false)
  extra_info   Json?       @default(dbgenerated("'[]'::jsonb")) @db.JsonB

  tags          GameTagRelation[]    @relation("game_tag")
  developers GameDeveloperRelation[] @relation("game_developer")
  characters GameCharacterRelation[] @relation("game_character")
  staffs     Json?                   @default(dbgenerated("'[]'::jsonb")) @db.JsonB
  link       GameLink[]              @relation("game_link")

  nsfw     Boolean  @default(false)
  type     String?
  platform String[] @default([])

  download_resources GameDownloadResource[] @relation("game_download_resource")
  malware_scan_cases MalwareScanCase[]      @relation("game_malware_scan_case")
  downloads          Int                    @default(0)

  views Int @default(0)
  hot_score Float @default(0)

  creator_id Int
  creator    User @relation("user_create_game", fields: [creator_id], references: [id])

  favorite_items FavoriteItem[] @relation("favorite_game_item")
  activities     Activity[]             @relation("game_activity")

  comments Comment[] @relation("game_comment")

  messages Message[] @relation("game_message")

  pvn_mappings UserGamePvnMapping[] @relation("game_pvn_mapping")

  walkthroughs Walkthrough[] @relation("game_walkthrough")

  relations_from GameRelation[] @relation("GameRelationFrom")
  relations_to   GameRelation[] @relation("GameRelationTo")

  status  Int      @default(1)
  created DateTime @default(now())
  updated DateTime @updatedAt

  @@unique([b_id, v_id])
  @@index([b_id, v_id])
  @@index([b_id])
  @@index([v_id])
  @@index([hot_score])
  @@index([downloads])
  @@map("games")
}

model GameRelation {
  id           Int              @id @default(autoincrement())
  from_game_id Int
  to_game_id   Int
  relation     GameRelationType

  from_game Game @relation("GameRelationFrom", fields: [from_game_id], references: [id], onDelete: Cascade)
  to_game   Game @relation("GameRelationTo", fields: [to_game_id], references: [id], onDelete: Cascade)

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@unique([from_game_id, to_game_id])
  @@index([from_game_id])
  @@index([to_game_id])
  @@map("game_relations")
}

model GameLink {
  id    Int    @id @default(autoincrement())
  url   String
  label String
  name  String

  created DateTime @default(now())
  updated DateTime @updatedAt

  game_id Int
  game    Game @relation("game_link", fields: [game_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("game_links")
}

model GameCover {
  id Int @id @default(autoincrement())

  language String
  url      String
  type     String
  dims     Int[]
  sexual   Int
  violence Int
  source     String?
  source_key String?
  source_url String?

  created DateTime @default(now())
  updated DateTime @updatedAt

  game_id Int
  game    Game @relation("game_cover", fields: [game_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([source, source_key])
  @@map("game_covers")
}

model GameImage {
  id Int @id @default(autoincrement())

  url      String
  dims     Int[]
  sexual   Int
  violence Int
  source     String?
  source_key String?
  source_url String?

  created DateTime @default(now())
  updated DateTime @updatedAt

  game_id Int
  game    Game @relation("game_image", fields: [game_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([source, source_key])
  @@map("game_images")
}

model Tag {
  id      Int              @id @default(autoincrement())
  name    String           @unique
  aliases String[]         @default([])
  count   Int              @default(0)
  games   GameTagRelation[] @relation("tag_game")

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@index([count])
  @@map("tags")
}

model GameTagRelation {
  game_id   Int
  tag_id    Int
  tag_alias String?
  game      Game @relation("game_tag",  fields: [game_id], references: [id], onDelete: Cascade)
  tag       Tag  @relation("tag_game", fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([game_id, tag_id])
  @@index([tag_id])
  @@map("game_tag_relations")
}
