APP_ENV=development
DEFAULT_LOCALE=en
LOG_FORMAT=text
LOG_LEVEL=info
PORT=5000
SITE_URL=http://localhost:3200
ALLOW_REGISTER=true
CORS_ORIGIN=http://localhost:3200

WORKERS_ENABLED=true
ENABLE_BACKUP=false
SEARCH_ENGINE=pg
TASKS_IMAGE_UPLOAD_ENABLED=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_KEY_PREFIX=shionlib

FILE_SCAN_ENABLED=true
CLAMDSCAN_HOST=clamav
CLAMDSCAN_PORT=3310
CLAMDSCAN_TIMEOUT=120s
FILE_DOWNLOAD_MODE=worker
FILE_DOWNLOAD_CDN_HOST=https://ft.hikarifallback.uk
FILE_DOWNLOAD_PROXY_WORKER_HOST=http://localhost:8787
FILE_DOWNLOAD_TICKET_SECRET=dev-download-ticket-secret
FILE_DOWNLOAD_MAX_CONNS=4

TOKEN_SECRET=dev-token-secret
TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_SHORT_WINDOW=300s
REFRESH_TOKEN_LONG_WINDOW=1209600s
REFRESH_TOKEN_PEPPER=dev-refresh-pepper
REFRESH_TOKEN_ROTATION_GRACE=100s
REFRESH_TOKEN_ALGORITHM_VERSION=slrt1
AUTH_COOKIE_SECURE=true

THROTTLE_AUTH_LIMIT=100000

WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3200
OIDC_ALLOWED_ORIGINS=http://localhost:3200

EMAIL_PROVIDER=elastic
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_ENDPOINT=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=

S3_IMAGE_BUCKET=shionlib-local-image
S3_IMAGE_REGION=us-east-1
S3_IMAGE_ENDPOINT=
S3_IMAGE_ACCESS_KEY_ID=local
S3_IMAGE_SECRET_ACCESS_KEY=local

S3_FILE_BUCKET=shionlib-local-file
S3_FILE_REGION=us-east-1
S3_FILE_ENDPOINT=
S3_FILE_ACCESS_KEY_ID=local
S3_FILE_SECRET_ACCESS_KEY=local

S3_BACKUP_BUCKET=shionlib-local-backup
S3_BACKUP_REGION=us-east-1
S3_BACKUP_ENDPOINT=
S3_BACKUP_ACCESS_KEY_ID=local
S3_BACKUP_SECRET_ACCESS_KEY=local


BANGUMI_CLIENT_ID=
BANGUMI_CLIENT_SECRET=

NEXTMOE_API_BASE_URL=https://api.nextmoe.dev
NEXTMOE_API_KEY=
AI_KEY_SECRET=e2e-ai-key-secret-with-at-least-32-chars
